<div class="text-center py-12" ...attributes>
    <FaIcon @icon="inbox" class="mx-auto h-12 w-12 text-gray-400 dark:text-gray-600" />
    <h3 class="mt-2 text-sm font-semibold text-gray-900 dark:text-white">{{t "registry-bridge.developers.extensions.explore.no-extensions-published"}}</h3>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        {{t "registry-bridge.developers.extensions.explore.no-extensions-published-help"}}
    </p>
    {{#if this.canConfigureRegistry}}
        <div class="mt-6">
            <Button @text={{t "registry-bridge.developers.extensions.explore.open-registry-config"}} @icon="gear" @type="primary" @onClick={{this.goToRegistryConfig}} />
        </div>
    {{/if}}
</div>