<ContentPanel @title="Registry Configuration" @open={{true}} @wrapperClass="bordered-classic">
    <InputGroup
        @name="Registry Host"
        @value={{this.registryHost}}
        @helpText="Base URL of the Fleetbase extensions registry this instance reads its catalog from."
        disabled={{this.isBusy}}
    />
    <InputGroup @name="Registry Token" @helpText="Bearer token used to authenticate with the registry. Reveal the saved token or replace it with a new one." as |id|>
        {{#if this.isEditingToken}}
            <div class="flex items-center space-x-2">
                <Input
                    id={{id}}
                    @type="text"
                    @value={{this.registryToken}}
                    class="w-full form-input"
                    placeholder="Paste a registry token"
                    autocomplete="off"
                    spellcheck="false"
                    disabled={{this.isBusy}}
                />
                <Button @text="Cancel" @size="sm" @onClick={{this.cancelEditToken}} @disabled={{this.isBusy}} />
            </div>
        {{else}}
            <div class="flex items-center space-x-2">
                <div class="flex-1 min-w-0">
                    <ClickToReveal @value={{this.registryToken}} @clickToCopy={{true}} @buttonText="Reveal token" />
                </div>
                <Button @text="Change" @icon="pen" @size="sm" @onClick={{this.editToken}} @disabled={{this.isBusy}} />
            </div>
        {{/if}}
    </InputGroup>
    {{#if this.testResult}}
        <div class="rounded-md border p-3 text-sm {{if this.testResult.ok 'border-green-300 bg-green-50 dark:bg-green-900/20 dark:border-green-800' 'border-red-300 bg-red-50 dark:bg-red-900/20 dark:border-red-800'}}">
            <div class="flex items-center space-x-2 font-semibold {{if this.testResult.ok 'text-green-700 dark:text-green-300' 'text-red-700 dark:text-red-300'}}">
                <FaIcon @icon={{if this.testResult.ok "circle-check" "circle-xmark"}} />
                <span>{{if this.testResult.ok "Connected to the registry" "Unable to connect to the registry"}}</span>
            </div>
            <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-gray-700 dark:text-gray-300">
                <dt class="font-medium">Host</dt>
                <dd class="truncate">{{n-a this.testResult.host}}</dd>
                <dt class="font-medium">HTTP status</dt>
                <dd>{{n-a this.testResult.status}}</dd>
                <dt class="font-medium">Latency</dt>
                <dd>{{this.testResult.latency_ms}} ms</dd>
                <dt class="font-medium">Published extensions</dt>
                <dd>{{n-a this.testResult.extension_count}}</dd>
            </dl>
            {{#if this.testResult.error}}
                <div class="mt-2 text-red-700 dark:text-red-300">{{this.testResult.error}}</div>
            {{/if}}
        </div>
    {{/if}}
</ContentPanel>
<EmberWormhole @to="next-view-section-subheader-actions">
    <div class="flex items-center space-x-2">
        <Button
            @type="default"
            @size="sm"
            @icon="plug"
            @text="Test Connection"
            @onClick={{perform this.testConnection}}
            @disabled={{this.isBusy}}
            @isLoading={{this.testConnection.isRunning}}
        />
        <Button
            @type="primary"
            @size="sm"
            @icon="save"
            @text="Save Changes"
            @onClick={{perform this.saveConfigValues}}
            @disabled={{this.isBusy}}
            @isLoading={{this.saveConfigValues.isRunning}}
        />
    </div>
</EmberWormhole>
<Spacer @height="400px" />