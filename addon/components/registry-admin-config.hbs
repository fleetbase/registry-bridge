<ContentPanel @title={{t "registry-bridge.admin.config.service.title"}} @open={{true}} @wrapperClass="bordered-classic">
    <InputGroup
        @name={{t "registry-bridge.admin.config.service.url"}}
        @value={{this.serviceUrl}}
        @placeholder="https://registry.fleetbase.io"
        @helpText={{t "registry-bridge.admin.config.service.url-help"}}
        disabled={{this.isBusy}}
        data-test-service-url
    />
    <InputGroup @name={{t "registry-bridge.admin.config.registration.title"}} @helpText={{t "registry-bridge.admin.config.registration.help"}} as |id|>
        {{#if this.isRegistered}}
            <div class="rounded-md border border-gray-200 dark:border-gray-700 p-3 text-sm" data-test-registration-status>
                <div class="flex items-center space-x-2 font-semibold text-green-700 dark:text-green-300">
                    <FaIcon @icon="circle-check" />
                    <span>{{t "registry-bridge.admin.config.registration.registered"}}</span>
                </div>
                <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-gray-700 dark:text-gray-300">
                    <dt class="font-medium">{{t "registry-bridge.admin.config.registration.instance"}}</dt>
                    <dd class="truncate">{{n-a this.instance.name}} <span class="text-gray-500">{{this.instance.id}}</span></dd>
                    <dt class="font-medium">{{t "registry-bridge.admin.config.registration.organization"}}</dt>
                    <dd class="truncate">{{n-a this.instance.organization.name}}</dd>
                    <dt class="font-medium">{{t "registry-bridge.admin.config.registration.token"}}</dt>
                    <dd class="font-mono" data-test-token-hint>{{n-a this.instance.token_hint}}</dd>
                    <dt class="font-medium">{{t "registry-bridge.admin.config.registration.registered-at"}}</dt>
                    <dd>{{n-a this.instance.registered_at}}</dd>
                </dl>
                {{#if this.isReregistering}}
                    <div class="mt-3 space-y-1" data-test-reregister>
                        <div class="text-xs text-gray-500 dark:text-gray-400">{{t "registry-bridge.admin.config.registration.register-again-help"}}</div>
                        <div class="flex items-center space-x-2">
                            <Input
                                id={{id}}
                                @type="text"
                                @value={{this.registrationCode}}
                                class="w-full form-input font-mono uppercase"
                                placeholder="XXXX-XXXX-XXXX-XXXX"
                                autocomplete="off"
                                spellcheck="false"
                                disabled={{this.isBusy}}
                            />
                            <Button
                                @type="primary"
                                @size="sm"
                                @icon="rotate"
                                @text={{t "registry-bridge.admin.config.registration.register-again"}}
                                @onClick={{perform this.registerInstance}}
                                @disabled={{not this.canRegister}}
                                @isLoading={{this.registerInstance.isRunning}}
                            />
                            <Button @size="sm" @text={{t "registry-bridge.admin.config.registration.cancel"}} @onClick={{this.cancelReregister}} @disabled={{this.isBusy}} />
                        </div>
                    </div>
                {{else}}
                    <div class="mt-3 flex items-center space-x-2">
                        <Button
                            @size="sm"
                            @icon="rotate"
                            @text={{t "registry-bridge.admin.config.registration.register-again"}}
                            @onClick={{this.startReregister}}
                            @disabled={{this.isBusy}}
                        />
                        <Button
                            @type="danger"
                            @size="sm"
                            @icon="link-slash"
                            @text={{t "registry-bridge.admin.config.unregister.accept"}}
                            @onClick={{this.confirmUnregister}}
                            @disabled={{this.isBusy}}
                        />
                    </div>
                {{/if}}
            </div>
        {{else}}
            <div class="flex items-center space-x-2">
                <Input
                    id={{id}}
                    @type="text"
                    @value={{this.registrationCode}}
                    class="w-full form-input font-mono uppercase"
                    placeholder="XXXX-XXXX-XXXX-XXXX"
                    autocomplete="off"
                    spellcheck="false"
                    disabled={{this.isBusy}}
                />
                <Button
                    @type="primary"
                    @size="sm"
                    @icon="link"
                    @text={{t "registry-bridge.admin.config.registration.register"}}
                    @onClick={{perform this.registerInstance}}
                    @disabled={{not this.canRegister}}
                    @isLoading={{this.registerInstance.isRunning}}
                />
            </div>
            {{#unless this.serviceUrl}}
                <div class="mt-1 text-xs text-gray-500">{{t "registry-bridge.admin.config.registration.url-first"}}</div>
            {{/unless}}
        {{/if}}
    </InputGroup>
</ContentPanel>
{{#if this.testResult}}
    <div
        class="rounded-md border p-3 text-sm
            {{if this.testResult.ok 'border-green-300 bg-green-50 dark:bg-green-900/20 dark:border-green-800' 'border-red-300 bg-red-50 dark:bg-red-900/20 dark:border-red-800'}}"
        data-test-connection-result
    >
        <div class="flex items-center space-x-2 font-semibold {{if this.testResult.ok 'text-green-700 dark:text-green-300' 'text-red-700 dark:text-red-300'}}">
            <FaIcon @icon={{if this.testResult.ok "circle-check" "circle-xmark"}} />
            <span>{{if this.testResult.ok (t "registry-bridge.admin.config.result.connected") (t "registry-bridge.admin.config.result.failed")}}</span>
        </div>
        <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-gray-700 dark:text-gray-300">
            <dt class="font-medium">{{t "registry-bridge.admin.config.result.host"}}</dt>
            <dd class="truncate">{{n-a this.testResult.host}}</dd>
            <dt class="font-medium">{{t "registry-bridge.admin.config.result.status"}}</dt>
            <dd>{{n-a this.testResult.status}}</dd>
            <dt class="font-medium">{{t "registry-bridge.admin.config.result.latency"}}</dt>
            <dd>{{this.testResult.latency_ms}} ms</dd>
            <dt class="font-medium">{{t "registry-bridge.admin.config.result.extensions"}}</dt>
            <dd>{{n-a this.testResult.extension_count}}</dd>
            {{#if this.testResult.instance}}
                <dt class="font-medium">{{t "registry-bridge.admin.config.registration.token"}}</dt>
                <dd data-test-instance-check>
                    {{#if this.testResult.instance.ok}}
                        {{t "registry-bridge.admin.config.result.token-accepted" name=(n-a this.testResult.instance.name) organization=(n-a this.testResult.instance.organization)}}
                    {{else}}
                        {{t "registry-bridge.admin.config.result.token-rejected"}}{{#if this.testResult.instance.error}}: {{this.testResult.instance.error}}{{/if}}
                    {{/if}}
                </dd>
            {{/if}}
        </dl>
        {{#if this.testResult.error}}
            <div class="mt-2 text-red-700 dark:text-red-300">{{this.testResult.error}}</div>
        {{/if}}
    </div>
{{/if}}
<EmberWormhole @to="next-view-section-subheader-actions">
    <div class="flex items-center space-x-2">
        <Button
            @type="default"
            @size="sm"
            @icon="plug"
            @text={{t "registry-bridge.admin.config.test"}}
            @onClick={{perform this.testConnection}}
            @disabled={{this.isBusy}}
            @isLoading={{this.testConnection.isRunning}}
        />
        <Button
            @type="primary"
            @size="sm"
            @icon="save"
            @text={{t "registry-bridge.admin.config.save"}}
            @onClick={{perform this.saveConfigValues}}
            @disabled={{this.isBusy}}
            @isLoading={{this.saveConfigValues.isRunning}}
        />
    </div>
</EmberWormhole>
<Spacer @height="400px" />
