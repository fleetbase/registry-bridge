<div class="my-4 space-y-2 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-800 dark:bg-red-900 dark:bg-opacity-30 dark:text-red-200" role="alert" data-test-installer-job-error>
    <div class="flex flex-row items-center space-x-2 font-semibold">
        <FaIcon @icon="circle-exclamation" />
        <span data-test-installer-job-error-step>
            {{#if @error.step}}
                {{t "registry-bridge.installer.failed-at" step=@error.step}}
            {{else}}
                {{t "registry-bridge.installer.failed"}}
            {{/if}}
        </span>
    </div>
    <div class="break-words" data-test-installer-job-error-message>{{@error.message}}</div>
    {{#if @error.rolledBack}}
        <div data-test-installer-job-error-rolled-back>{{t "registry-bridge.installer.rolled-back"}}</div>
    {{/if}}
    {{#if @error.rebuildRequired}}
        <div>{{t "registry-bridge.installer.rebuild-required"}}</div>
    {{/if}}
    {{#if @error.log.length}}
        <details data-test-installer-job-error-log>
            <summary class="cursor-pointer select-none">{{t "registry-bridge.installer.show-log"}}</summary>
            <div class="mt-2 max-h-60 overflow-auto rounded bg-white px-2 py-1 font-mono text-xs text-gray-800 dark:bg-gray-900 dark:text-gray-200">
                {{#each @error.log as |line|}}
                    <div class="whitespace-pre-wrap">{{line}}</div>
                {{/each}}
            </div>
        </details>
    {{/if}}
</div>
