<div class="extension-panel-section space-y-4" data-test-extension-panel-overview>
    {{#if @extension.self_managed}}
        <section class="space-y-3" aria-labelledby="self-managed-title" data-test-self-managed>
            <InfoBlock @type="info" @icon="server">
                <strong id="self-managed-title">{{t "registry-bridge.self-managed.title"}}</strong>
                {{t "registry-bridge.self-managed.what"}}
            </InfoBlock>
            <ol class="extension-panel-steps">
                <li>
                    <div class="font-semibold">{{t "registry-bridge.self-managed.step.token"}}</div>
                    <div class="text-xs text-gray-500 dark:text-gray-400">{{t "registry-bridge.self-managed.step.token-help"}}</div>
                </li>
                <li>
                    <div class="font-semibold">{{t "registry-bridge.self-managed.step.cli"}}</div>
                    <ClickToCopy @value="npm i -g @fleetbase/cli"><code>npm i -g @fleetbase/cli</code></ClickToCopy>
                </li>
                <li>
                    <div class="font-semibold">{{t "registry-bridge.self-managed.step.auth"}}</div>
                    <ClickToCopy @value={{concat "flb set-auth <YOUR_TOKEN> --registry " this.registryHost}}><code>flb set-auth &lt;YOUR_TOKEN&gt; --registry {{this.registryHost}}</code></ClickToCopy>
                </li>
                <li>
                    <div class="font-semibold">{{t "registry-bridge.self-managed.step.install"}}</div>
                    <ClickToCopy @value={{concat "flb install " this.installTarget}}><code>flb install {{this.installTarget}}</code></ClickToCopy>
                </li>
            </ol>
        </section>
    {{/if}}

    {{#if @extension.description}}
        <p class="text-sm dark:text-gray-200" data-test-extension-panel-description>{{@extension.description}}</p>
    {{/if}}
    {{#if @extension.promotional_text}}
        <div class="extension-details-promo-content dark:text-gray-200 text-sm">{{html-safe @extension.promotional_text}}</div>
    {{/if}}
    {{#if this.compat}}
        <InfoBlock @type="default" @icon="code-compare" @text={{this.compat}} data-test-extension-panel-compat />
    {{/if}}

    <dl class="extension-panel-facts">
        {{#if @extension.meta.installs_count}}
            <div><dt>{{t "registry-bridge.detail.installs"}}</dt><dd>{{@extension.meta.installs_count}}</dd></div>
        {{/if}}
        {{#if this.lastRelease}}
            <div><dt>{{t "registry-bridge.detail.last-release"}}</dt><dd>v{{this.lastRelease.version}}</dd></div>
        {{/if}}
        {{#if @extension.support_url}}
            <div><dt>{{t "registry-bridge.detail.support"}}</dt><dd><a href={{@extension.support_url}} target="_blank" rel="noopener noreferrer">{{@extension.support_url}}</a></dd></div>
        {{/if}}
    </dl>

    {{#if @extension.tags.length}}
        <div class="flex flex-row flex-wrap items-center gap-1" data-test-extension-panel-tags>
            {{#each @extension.tags as |tag|}}
                <Badge @status="default" @size="xs" @hideStatusDot={{true}} @disableHumanize={{true}}>{{tag}}</Badge>
            {{/each}}
        </div>
    {{/if}}
</div>
