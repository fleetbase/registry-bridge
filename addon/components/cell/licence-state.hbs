{{#if this.badge}}
    <Badge @status={{this.badge.status}} @size="xs" @hideStatusDot={{true}} @disableHumanize={{true}} @helpText={{this.badge.help}} data-test-licence-state={{this.state}} data-test-licence-reason={{if this.badge.help this.reason}}>{{this.badge.text}}</Badge>
{{else}}
    <span class="text-xs text-gray-500 dark:text-gray-400">-</span>
{{/if}}
