<div class="rb-page rb-extension-page" data-test-extension-page={{this.extension.slug}}>
    {{#if this.isLoading}}
        <div class="rb-loading" aria-busy="true"><Spinner /></div>
    {{else if this.error}}
        <InfoBlock @type="danger" @icon="triangle-exclamation">
            <div class="font-semibold">{{t "registry-bridge.store.page.not-found"}}</div>
            <div class="mt-3"><Button @size="xs" @icon="rotate-right" @text={{t "registry-bridge.common.retry"}} @onClick={{this.reload}} /></div>
        </InfoBlock>
    {{else if this.extension}}
        <nav class="rb-breadcrumb" aria-label={{t "registry-bridge.store.breadcrumb"}}>
            <LinkTo @route="explore.index" class="rb-link">{{t "registry-bridge.store.nav.discover"}}</LinkTo>
            {{#if this.extension.category.slug}}
                <span aria-hidden="true">›</span>
                <LinkTo @route="explore.category" @model={{this.extension.category.slug}} class="rb-link">{{this.extension.category_name}}</LinkTo>
            {{/if}}
            <span aria-hidden="true">›</span>
            <span aria-current="page">{{this.extension.name}}</span>
        </nav>

        <div class="rb-extension-layout">
            <div class="rb-extension-main">
                <header class="rb-extension-head">
                    <Registry::ExtensionIcon @extension={{this.extension}} @size="xl" />
                    <div class="rb-extension-id">
                        <h1 class="rb-extension-name">{{this.extension.name}}</h1>
                        {{#if this.extension.subtitle}}
                            <p class="rb-extension-subtitle">{{this.extension.subtitle}}</p>
                        {{/if}}
                        <p class="rb-extension-byline">
                            {{#if this.publisher}}
                                <span class="rb-publisher">
                                    {{this.publisher}}
                                    {{#if this.verified}}
                                        <FaIcon @icon="circle-check" @size="xs" class="rb-verified" />
                                        <span class="sr-only">{{t "registry-bridge.store.verified"}}</span>
                                    {{/if}}
                                </span>
                            {{/if}}
                            {{#if this.extension.category_name}}<span>· {{this.extension.category_name}}</span>{{/if}}
                            {{#each this.addsTo as |app|}}<span>· {{t "registry-bridge.store.page.adds-to" app=app}}</span>{{/each}}
                        </p>
                        <div class="rb-extension-actions">
                            <Registry::InstallButton @extension={{this.extension}} @size="lg" />
                            <Registry::Verdict @extension={{this.extension}} />
                            {{#if this.canRemove}}
                                <button type="button" class="rb-link rb-link-danger" {{on "click" this.remove}} data-test-extension-remove>{{t "registry-bridge.store.page.remove"}}</button>
                            {{/if}}
                        </div>
                        {{#if this.locationPath}}
                            <p class="rb-extension-location" data-test-extension-location><FaIcon @icon="location-arrow" @size="xs" />
                                {{t "registry-bridge.store.page.find-it" path=this.locationPath}}</p>
                        {{/if}}
                    </div>
                </header>

                {{#if this.failure}}
                    <section class="rb-failure" role="alert" data-test-install-failure>
                        <div class="rb-failure-head">
                            <FaIcon @icon="circle-exclamation" />
                            <div>
                                <strong>{{t
                                        (if (eq this.failure.action "update") "registry-bridge.store.failure.update-title" "registry-bridge.store.failure.title")
                                        name=this.extension.name
                                    }}</strong>
                                <p>{{this.failure.failure.summary}}</p>
                            </div>
                        </div>
                        <div class="rb-failure-actions">
                            <button type="button" class="rb-btn rb-btn-light" {{on "click" this.retry}} data-test-install-retry>{{t "registry-bridge.store.failure.retry"}}</button>
                            <button type="button" class="rb-btn rb-btn-ghost" {{on "click" this.dismissFailure}}>{{t "registry-bridge.store.failure.dismiss"}}</button>
                        </div>
                        {{#if this.canSeeDetails}}
                            <details class="rb-failure-details">
                                <summary>{{t "registry-bridge.store.verdict.details"}}</summary>
                                {{#if this.failure.failure.message}}<p>{{this.failure.failure.message}}</p>{{/if}}
                                {{#if this.failure.details.length}}
                                    <ul>
                                        {{#each this.failure.details as |stage|}}
                                            <li class="is-{{stage.status}}">{{stage.label}}{{#if stage.seconds}} · {{stage.seconds}}s{{/if}}</li>
                                        {{/each}}
                                    </ul>
                                {{/if}}
                                {{#if this.failure.failure.log.length}}
                                    <pre>{{#each this.failure.failure.log as |line|}}{{line}}
                                        {{/each}}</pre>
                                {{/if}}
                            </details>
                        {{/if}}
                    </section>
                {{/if}}

                {{#if this.screenshots.length}}
                    <div class="rb-shots" aria-label={{t "registry-bridge.store.page.screenshots"}}>
                        {{#each this.screenshots as |shot|}}
                            <a href={{shot.url}} target="_blank" rel="noopener noreferrer" class="rb-shot"><img
                                    src={{shot.url}}
                                    alt={{t "registry-bridge.store.page.screenshot-of" name=this.extension.name}}
                                    loading="lazy"
                                /></a>
                        {{/each}}
                    </div>
                {{/if}}

                <nav class="rb-tabs" aria-label={{t "registry-bridge.store.page.sections"}}>
                    {{#each this.tabs as |tab|}}
                        <button
                            type="button"
                            class="rb-tab {{if tab.current 'is-current'}}"
                            aria-pressed={{if tab.current "true" "false"}}
                            {{on "click" (fn this.selectTab tab.id)}}
                            data-test-extension-tab={{tab.id}}
                        >
                            {{t (concat "registry-bridge.store.page.tabs." tab.id)}}
                        </button>
                    {{/each}}
                </nav>

                {{#if (eq this.tab "overview")}}
                    {{#if this.extension.description}}
                        <p class="rb-prose">{{this.extension.description}}</p>
                    {{/if}}
                    {{#if this.extension.promotional_text}}
                        <div class="rb-prose extension-details-promo-content">{{html-safe this.extension.promotional_text}}</div>
                    {{/if}}
                    {{#if (or this.highlights.length this.setupSteps.length)}}
                        <div class="rb-cards-2">
                            {{#if this.highlights.length}}
                                <section class="rb-panel">
                                    <h2 class="rb-panel-title">{{t "registry-bridge.store.page.highlights"}}</h2>
                                    <ul class="rb-plus-list">
                                        {{#each this.highlights as |line|}}<li>{{line}}</li>{{/each}}
                                    </ul>
                                </section>
                            {{/if}}
                            {{#if this.setupSteps.length}}
                                <section class="rb-panel">
                                    <h2 class="rb-panel-title">{{t "registry-bridge.store.page.setup"}}</h2>
                                    <ol class="rb-steps-list">
                                        {{#each this.setupSteps as |line|}}<li>{{line}}</li>{{/each}}
                                    </ol>
                                </section>
                            {{/if}}
                        </div>
                    {{/if}}
                {{else if (eq this.tab "whats-new")}}
                    <section class="rb-panel">
                        <h2 class="rb-panel-title">{{t "registry-bridge.store.page.version" version=this.extension.latest_version}}</h2>
                        <p class="rb-prose">{{or this.releaseNotes (t "registry-bridge.store.page.no-notes")}}</p>
                    </section>
                    {{#if this.versions.length}}
                        <ul class="rb-version-list">
                            {{#each this.versions as |release|}}
                                <li><span>{{release.version}}</span><span class="rb-muted">{{format-date-fns release.published_at "dd MMM yyyy"}}</span></li>
                            {{/each}}
                        </ul>
                    {{/if}}
                {{else}}
                    <section class="rb-panel">
                        {{#if this.links.length}}
                            <ul class="rb-link-list">
                                {{#each this.links as |link|}}
                                    <li><a href={{link.url}} target="_blank" rel="noopener noreferrer" class="rb-link">{{t (concat "registry-bridge.store.page.links." link.id)}}</a></li>
                                {{/each}}
                            </ul>
                        {{else}}
                            <p class="rb-muted">{{t "registry-bridge.store.page.no-links"}}</p>
                        {{/if}}
                    </section>
                {{/if}}

                {{#if this.more.length}}
                    <section class="rb-section">
                        <div class="rb-section-head">
                            <h2 class="rb-section-title">{{t "registry-bridge.store.page.more" category=this.extension.category_name}}</h2>
                        </div>
                        <Registry::ExtensionCollection @extensions={{this.more}} @view="cards" />
                    </section>
                {{/if}}
            </div>

            <aside class="rb-extension-side">
                <Registry::Verdict @extension={{this.extension}} @variant="card" />
                {{#if this.facts.length}}
                    <dl class="rb-facts">
                        {{#each this.facts as |fact|}}
                            <div><dt>{{fact.label}}</dt><dd>{{fact.value}}</dd></div>
                        {{/each}}
                    </dl>
                {{/if}}
                {{#if this.links.length}}
                    <section class="rb-panel">
                        <h2 class="rb-panel-title">{{t "registry-bridge.store.page.help"}}</h2>
                        <ul class="rb-link-list">
                            {{#each this.links as |link|}}
                                <li><a href={{link.url}} target="_blank" rel="noopener noreferrer" class="rb-link">{{t (concat "registry-bridge.store.page.links." link.id)}}</a></li>
                            {{/each}}
                        </ul>
                    </section>
                {{/if}}
                {{#if this.publisher}}
                    <section class="rb-panel rb-publisher-card">
                        <span class="rb-publisher-avatar" aria-hidden="true">{{first-char this.publisher}}</span>
                        <div>
                            <strong>{{this.publisher}}</strong>
                            {{#if this.verified}}<span class="rb-muted">{{t "registry-bridge.store.verified"}}</span>{{/if}}
                        </div>
                    </section>
                {{/if}}
            </aside>
        </div>
    {{/if}}
</div>