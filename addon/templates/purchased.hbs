<div class="rb-page rb-library" data-test-purchased-page>
    <div class="rb-library-head">
        <h1 class="rb-page-title">{{t "registry-bridge.store.library.purchased-title"}}</h1>
        <span class="rb-muted">{{if
                this.organizationName
                (t "registry-bridge.store.library.purchased-by" organization=this.organizationName)
                (t "registry-bridge.store.library.purchased-sub")
            }}</span>
    </div>
    <p class="rb-muted rb-library-note">{{t "registry-bridge.store.library.purchased-note"}}</p>

    {{#if this.isLoading}}
        <div class="rb-loading" aria-busy="true"><Skeleton::Table @rows={{3}} @columns={{4}} @checkbox={{false}} /></div>
    {{else if this.error}}
        <InfoBlock @type="danger" @icon="triangle-exclamation">
            <div class="font-semibold">{{t "registry-bridge.store.error"}}</div>
            <div class="mt-3"><Button @size="xs" @icon="rotate-right" @text={{t "registry-bridge.store.retry"}} @onClick={{perform this.load}} /></div>
        </InfoBlock>
    {{else if this.extensions.length}}
        <div class="rb-lib-list" role="list">
            {{#each this.extensions as |extension|}}
                <Registry::LibraryRow @extension={{extension}} @variant="purchased" />
            {{/each}}
        </div>
    {{else}}
        <div class="rb-empty" data-test-purchased-empty>
            <FaIcon @icon="receipt" @size="2x" class="rb-muted" />
            <p>{{t "registry-bridge.store.library.purchased-empty"}}</p>
            <LinkTo @route="explore.index" @query={{hash pricing="paid"}} class="rb-btn rb-btn-primary">{{t "registry-bridge.store.library.browse-paid"}}</LinkTo>
        </div>
    {{/if}}
</div>