<Layout::Section::Header @searchQuery={{this.query}} @onSearch={{perform this.search}} @title={{this.title}} />

<Layout::Section::Body class="overflow-y-scroll h-full">
    {{#if @model.length}}
        <Layout::Resource::CardsGrid
            @resource="registry-extension"
            @data={{@model}}
            @gap="sm"
            @columns="4"
            @showPagination={{true}}
            @page={{this.page}}
            @onPageChange={{fn (mut this.page)}}
            @paginationMeta={{@model.meta}}
            @containerClass="p-4"
            class="h-full"
            as |Item|
        >
            <ExtensionCard @resource={{Item.model}} />
        </Layout::Resource::CardsGrid>
    {{else}}
        <ExploreEmptyState />
    {{/if}}
</Layout::Section::Body>
