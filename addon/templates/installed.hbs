<div class="rb-page rb-library" data-test-installed-page>
    <div class="rb-library-head">
        <h1 class="rb-page-title">{{t "registry-bridge.store.library.installed-title"}}</h1>
        {{#if this.extensions.length}}<span class="rb-muted">{{t "registry-bridge.store.results.count" count=this.extensions.length}}</span>{{/if}}
    </div>

    {{#if this.firstUpdate}}
        <div class="rb-banner" data-test-updates-banner>
            <span class="rb-banner-title">{{t "registry-bridge.store.library.updates-ready" count=this.updatesAvailable}}</span>
            <span class="rb-muted">{{t "registry-bridge.store.library.update-for" name=this.firstUpdate.name version=this.firstUpdate.latest_version}}</span>
            <LinkTo @route="updates" class="rb-btn rb-btn-primary rb-banner-action">{{t "registry-bridge.store.library.review-updates"}}</LinkTo>
        </div>
    {{/if}}

    {{#if this.isLoading}}
        <div class="rb-loading" aria-busy="true"><Skeleton::Table @rows={{4}} @columns={{4}} @checkbox={{false}} /></div>
    {{else if this.error}}
        <InfoBlock @type="danger" @icon="triangle-exclamation">
            <div class="font-semibold">{{t "registry-bridge.store.error"}}</div>
            <div class="mt-3"><Button @size="xs" @icon="rotate-right" @text={{t "registry-bridge.store.retry"}} @onClick={{perform this.load}} /></div>
        </InfoBlock>
    {{else if this.extensions.length}}
        <div class="rb-lib-list" role="list">
            {{#each this.extensions as |extension|}}
                <Registry::LibraryRow @extension={{extension}} />
            {{/each}}
        </div>
    {{else}}
        <div class="rb-empty" data-test-installed-empty>
            <FaIcon @icon="shapes" @size="2x" class="rb-muted" />
            <p>{{t "registry-bridge.store.library.installed-empty"}}</p>
            <LinkTo @route="explore" class="rb-btn rb-btn-primary">{{t "registry-bridge.store.library.browse"}}</LinkTo>
        </div>
    {{/if}}
</div>