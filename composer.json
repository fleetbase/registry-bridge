{
    "name": "fleetbase/registry-bridge",
    "version": "0.1.11",
    "description": "Internal Bridge between Fleetbase API and Extensions Registry",
    "keywords": [
        "fleetbase-extension",
        "fleetbase-registry-bridge",
        "fleetbase"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Fleetbase Pte Ltd.",
            "email": "hello@fleetbase.io"
        },
        {
            "name": "Ronald A. Richardson",
            "email": "ron@fleetbase.io"
        }
    ],
    "require": {
        "php": "^8.0",
        "fleetbase/core-api": "*",
        "laravel/cashier": "^16.2.0",
        "php-http/guzzle7-adapter": "^1.0",
        "psr/http-factory-implementation": "*",
        "stripe/stripe-php": "^17.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.34.1",
        "laravel/framework": "^10.0",
        "nunomaduro/collision": "^7.0",
        "pestphp/pest": "^2.33.2",
        "phpstan/phpstan": "^1.10.38",
        "symfony/var-dumper": "^5.4.29|^6.2"
    },
    "autoload": {
        "psr-4": {
            "Fleetbase\\RegistryBridge\\": "server/src/",
            "Fleetbase\\RegistryBridge\\Seeders\\": "server/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fleetbase\\RegistryBridge\\Tests\\": "server/tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Fleetbase\\RegistryBridge\\Providers\\RegistryBridgeServiceProvider"
            ]
        },
        "fleetbase": {
            "sandbox-migrations": false
        },
        "fleetbase/registry-bridge": {
            "excludes": [
                "addon",
                "app",
                "assets",
                "config",
                "tests",
                "vendor"
            ]
        }
    },
    "config": {
        "vendor-dir": "./server_vendor",
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-b41t-wbzk-9q51": {
                        "reason": "TokenGuard bypass. Fixed on 10.x in v10.50.4, but Packagist still lists every 10.x version as affected. Remove at the Laravel 12.69+ upgrade.",
                        "on-audit": false
                    },
                    "PKSA-zwc5-qtrz-zm1n": {
                        "reason": "CRLF in the email rule, filed against illuminate/mail. No 10.x fix; symfony/mime rejects the payloads. Remove at the Laravel 12.69+ upgrade.",
                        "on-audit": false
                    },
                    "PKSA-mdq4-51ck-6kdq": {
                        "reason": "CRLF in the email rule (CVE-2026-48019). No 10.x fix; symfony/mime rejects the payloads. Remove at the Laravel 12.69+ upgrade.",
                        "on-audit": false
                    },
                    "PKSA-3r5d-mb8f-1qw9": {
                        "reason": "CRLF in the email rule. No 10.x fix; symfony/mime rejects the payloads. Remove at the Laravel 12.69+ upgrade.",
                        "on-audit": false
                    },
                    "PKSA-m5cs-t1y6-qpcs": {
                        "reason": "Temporary signed URL path confusion. No 10.x fix; local-driver temporary URLs are not used. Remove at the Laravel 12.69+ upgrade.",
                        "on-audit": false
                    },
                    "PKSA-d5tc-s1qs-h781": {
                        "reason": "Debug page XSS. No 10.x fix; needs APP_DEBUG=true. Remove at the Laravel 12.69+ upgrade.",
                        "on-audit": false
                    }
                }
            }
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix -v",
        "test:lint": "php-cs-fixer fix -v --dry-run",
        "test:types": "phpstan analyse --ansi --memory-limit=0",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
