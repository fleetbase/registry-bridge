; npm user config for installs from the Fleetbase Registry Service (see Support\PackageAuth).
; Holds no secret: the installer sets both variables in the environment of each pnpm/npm process.
; pnpm 11 ignores `//host/:_authToken` keys in environment variables, so it needs this file to read them.
${FLEETBASE_REGISTRY_NPM_AUTH_KEY}=${FLEETBASE_REGISTRY_TOKEN}
